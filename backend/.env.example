DECKLY_VERSION=0.1.0
DECKLY_LOG_LEVEL=INFO
DECKLY_PROBLEM_TYPE_BASE_URL=https://api.example.com/problems

DECKLY_DATABASE_URL=postgresql+asyncpg://deckly:deckly@localhost:5433/deckly
DECKLY_DATABASE_POOL_SIZE=5
DECKLY_DATABASE_MAX_OVERFLOW=5
DECKLY_DATABASE_POOL_TIMEOUT_SECONDS=10
DECKLY_DATABASE_HEALTH_CHECK_TIMEOUT_SECONDS=2
DECKLY_DATABASE_JOB_STORE_TIMEOUT_SECONDS=5
DECKLY_DATABASE_DOCUMENT_STORE_TIMEOUT_SECONDS=5

DECKLY_REDIS_URL=redis://localhost:6380/0
DECKLY_REDIS_CONNECT_TIMEOUT_SECONDS=2
DECKLY_REDIS_CONNECT_RETRIES=3

DECKLY_PROVIDER_MODEL_PROVIDER=anthropic
DECKLY_PROVIDER_MODEL_BASE_URL=https://api.anthropic.com
DECKLY_PROVIDER_MODEL_API_KEY=replace-me
DECKLY_PROVIDER_MODEL_NAME=claude-sonnet-5
DECKLY_PROVIDER_MODEL_MAX_OUTPUT_TOKENS=16000
DECKLY_PROVIDER_MODEL_TIMEOUT_SECONDS=180
