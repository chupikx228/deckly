DECKLY_PROVIDER_MEDIA_CIRCUIT_FAILURE_THRESHOLD=5
DECKLY_PROVIDER_MEDIA_CIRCUIT_RESET_SECONDS=30
DECKLY_PROVIDER_MEDIA_MAX_IMAGES=20
DECKLY_PROVIDER_MEDIA_CANDIDATES_PER_QUERY=10
DECKLY_PROVIDER_MEDIA_THUMBNAIL_WIDTH=960
DECKLY_PROVIDER_MEDIA_MAX_CONCURRENCY=4
DECKLY_PROVIDER_MEDIA_JUDGE_TIMEOUT_SECONDS=10
DECKLY_PROVIDER_MEDIA_JUDGE_DEADLINE_SECONDS=15
DECKLY_PROVIDER_MEDIA_JUDGE_MAX_ATTEMPTS=2
DECKLY_PROVIDER_MEDIA_JUDGED_CANDIDATES_PER_NOTE=4
DECKLY_PROVIDER_MODERATION_MODEL_NAME=claude-haiku-4-5
DECKLY_PROVIDER_MODERATION_MAX_OUTPUT_TOKENS=4000
DECKLY_PROVIDER_MODERATION_TIMEOUT_SECONDS=2
DECKLY_PROVIDER_MODERATION_FILTER_TIMEOUT_SECONDS=15
DECKLY_PROVIDER_MODERATION_FILTER_DEADLINE_SECONDS=20
DECKLY_PROVIDER_MODERATION_FILTER_MAX_ATTEMPTS=2
DECKLY_PROVIDER_MODERATION_MAX_CONCURRENCY=10
DECKLY_PROVIDER_STORAGE_ENDPOINT_URL=http://localhost:9100
DECKLY_PROVIDER_STORAGE_BUCKET=deckly-documents
DECKLY_PROVIDER_STORAGE_REGION=auto
DECKLY_PROVIDER_STORAGE_ACCESS_KEY_ID=deckly
DECKLY_PROVIDER_STORAGE_SECRET_ACCESS_KEY=deckly-local-storage
DECKLY_PROVIDER_STORAGE_UPLOAD_TIMEOUT_SECONDS=30
DECKLY_PROVIDER_STORAGE_UPLOAD_DEADLINE_SECONDS=60
DECKLY_PROVIDER_STORAGE_DELETE_TIMEOUT_SECONDS=5
DECKLY_PROVIDER_STORAGE_DELETE_DEADLINE_SECONDS=10
DECKLY_PROVIDER_STORAGE_DOWNLOAD_TIMEOUT_SECONDS=15
DECKLY_PROVIDER_STORAGE_DOWNLOAD_DEADLINE_SECONDS=30
DECKLY_PROVIDER_STORAGE_MAX_ATTEMPTS=2
DECKLY_PROVIDER_STORAGE_RETRY_BASE_DELAY_SECONDS=1
DECKLY_PROVIDER_STORAGE_RETRY_MAX_DELAY_SECONDS=5
DECKLY_PROVIDER_STORAGE_CIRCUIT_FAILURE_THRESHOLD=5
DECKLY_PROVIDER_STORAGE_CIRCUIT_RESET_SECONDS=30
DECKLY_PROVIDER_STORAGE_MAX_CONCURRENCY=8

DECKLY_LIMIT_GENERATION_JOBS_PER_DAY=20
DECKLY_LIMIT_GENERATION_JOBS_PER_ADDRESS_PER_DAY=100
DECKLY_LIMIT_GENERATION_JOB_TIMEOUT_SECONDS=570
DECKLY_LIMIT_REGENERATE_NOTE_TIMEOUT_SECONDS=10
DECKLY_LIMIT_NOTE_REGENERATIONS_PER_WINDOW=30
DECKLY_LIMIT_NOTE_REGENERATION_WINDOW_SECONDS=3600
DECKLY_LIMIT_DOCUMENT_MAX_BYTES=26214400
DECKLY_LIMIT_DOCUMENT_UPLOADS_PER_WINDOW=10
DECKLY_LIMIT_DOCUMENT_UPLOADS_PER_ADDRESS_PER_WINDOW=50
DECKLY_LIMIT_DOCUMENT_UPLOAD_WINDOW_SECONDS=3600
DECKLY_LIMIT_DOCUMENT_UPLOAD_MAX_CONCURRENCY=4
DECKLY_LIMIT_DOCUMENT_UPLOAD_MEMORY_BUDGET_BYTES=1619001344
DECKLY_LIMIT_DOCUMENT_UPLOAD_READ_TIMEOUT_SECONDS=120
DECKLY_LIMIT_DOCUMENT_WORKER_MEMORY_BUDGET_BYTES=1342177280
DECKLY_LIMIT_DOCUMENT_MAX_SOURCE_CHARACTERS=40000
DECKLY_LIMIT_DOCUMENT_PARSE_DEADLINE_SECONDS=30
DECKLY_LIMIT_RECORDING_MAX_BYTES=50331648
DECKLY_LIMIT_RECORDING_MAX_DURATION_SECONDS=900
DECKLY_LIMIT_RECORDING_UPLOAD_MAX_CONCURRENCY=1
DECKLY_LIMIT_RECORDING_UPLOAD_READ_TIMEOUT_SECONDS=240
DECKLY_LIMIT_RECORDING_URL_MAX_CONCURRENCY=1
DECKLY_LIMIT_RECORDING_URL_TIMEOUT_SECONDS=120
DECKLY_LIMIT_RECORDING_URL_FETCHES_PER_WINDOW=5
DECKLY_LIMIT_RECORDING_URL_FETCHES_PER_ADDRESS_PER_WINDOW=20
DECKLY_LIMIT_RECORDING_URL_SERVER_FETCHES_PER_WINDOW=200
DECKLY_LIMIT_RECORDING_URL_WINDOW_SECONDS=3600
DECKLY_LIMIT_ARTICLE_URL_MAX_CONCURRENCY=1
DECKLY_LIMIT_ARTICLE_URL_TIMEOUT_SECONDS=30
DECKLY_LIMIT_ARTICLE_URL_FETCHES_PER_WINDOW=10
DECKLY_LIMIT_ARTICLE_URL_FETCHES_PER_ADDRESS_PER_WINDOW=30
DECKLY_LIMIT_ARTICLE_URL_SERVER_FETCHES_PER_WINDOW=500
DECKLY_LIMIT_ARTICLE_URL_WINDOW_SECONDS=3600

DECKLY_REGENERATE_RATE_LIMIT_TIMEOUT_SECONDS=0.5
DECKLY_REGENERATE_SEARCH_TIMEOUT_SECONDS=4.0
DECKLY_REGENERATE_SEARCH_MAX_RESULTS=3
DECKLY_REGENERATE_SEARCH_MAX_SOURCE_CHARACTERS=4000
DECKLY_REGENERATE_MODEL_TIMEOUT_SECONDS=3.25
DECKLY_REGENERATE_MODEL_MAX_OUTPUT_TOKENS=1000
DECKLY_REGENERATE_REQUEST_MODERATION_TIMEOUT_SECONDS=4.0
DECKLY_REGENERATE_NOTE_MODERATION_TIMEOUT_SECONDS=1.75

DECKLY_CACHE_GENERATION_RESULT_TTL_SECONDS=43200
DECKLY_CACHE_IDEMPOTENCY_KEY_TTL_SECONDS=86400
DECKLY_CACHE_JOB_RETENTION_SECONDS=86400
DECKLY_CACHE_DOCUMENT_RETENTION_SECONDS=86400
# Optional, default 3600. Must not exceed the document retention above.
# DECKLY_CACHE_TRANSCRIPT_TTL_SECONDS=21600
# Unset, the result cache shares DECKLY_REDIS_URL (single local Redis). In production point it at
# its own allkeys-lru instance, so cache pressure cannot evict queue or quota keys. Only the worker
# reads it. Leave the line out rather than blank: a blank value is rejected.
# DECKLY_CACHE_REDIS_URL=redis://cache.internal:6379/0

DECKLY_SWEEP_INTERVAL_MINUTES=5
DECKLY_SWEEP_RUNNING_STALE_AFTER_SECONDS=1200
DECKLY_SWEEP_QUEUED_STALE_AFTER_SECONDS=3600
# Recordings wait for a transcription worker that takes them one at a time, so they get a longer
# threshold. Startup refuses one shorter than 8 waiting + 1 running x the transcription job timeout.
DECKLY_SWEEP_RECORDING_QUEUED_STALE_AFTER_SECONDS=10800
DECKLY_SWEEP_BATCH_SIZE=500
DECKLY_SWEEP_DOCUMENT_BATCH_SIZE=100

DECKLY_OBSERVABILITY_TRACE_EXPORTER=none
DECKLY_OBSERVABILITY_WORKER_METRICS_HOST=127.0.0.1
DECKLY_OBSERVABILITY_WORKER_METRICS_PORT=9464
DECKLY_OBSERVABILITY_TRANSCRIPTION_WORKER_METRICS_PORT=9465

# Recordings are transcribed by deckly-transcription-worker (make transcription-worker), which needs
# ffmpeg on PATH and the model fetched by make model. Set ENABLED=false on a deployment without that
# worker: POST /generations then refuses recordings with 422 DOCUMENT_NOT_SUPPORTED_FOR_GENERATION.
DECKLY_TRANSCRIPTION_ENABLED=true
DECKLY_TRANSCRIPTION_MODEL_DIRECTORY=models/faster-whisper-small
DECKLY_TRANSCRIPTION_CPU_THREADS=2
DECKLY_TRANSCRIPTION_DEADLINE_SECONDS=540
DECKLY_TRANSCRIPTION_DECODE_DEADLINE_SECONDS=30
DECKLY_TRANSCRIPTION_JOB_TIMEOUT_SECONDS=960
DECKLY_TRANSCRIPTION_WORKER_MEMORY_BUDGET_BYTES=2684354560
